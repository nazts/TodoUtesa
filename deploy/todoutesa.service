[Unit]
Description=TodoUtesa (tareas, pomodoro, nube UTESA, Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ajusta la ruta a donde tengas el proyecto
WorkingDirectory=/opt/TodoUtesa
ExecStart=/usr/bin/python3 /opt/TodoUtesa/servidor.py
Environment=NO_BROWSER=1
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# usuario sin privilegios recomendado
# User=todoutesa
# Group=todoutesa

[Install]
WantedBy=multi-user.target
